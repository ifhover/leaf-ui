{
  "name": "leaf-ui-workspace",
  "version": "0.1.0",
  "private": true,
  "description": "Leaf UI — a themeable React component library",
  "packageManager": "pnpm@11.10.0",
  "engines": {
    "node": "^22.22.2 || ^24.15.0 || >=26.0.0",
    "pnpm": ">=11 <12"
  },
  "scripts": {
    "dev": "pnpm --filter @leaf-ui/docs dev",
    "build": "pnpm build:lib && pnpm build:docs",
    "build:lib": "pnpm --filter @sudden3/leaf-ui build && pnpm --filter @sudden3/leaf-ui check:package",
    "build:docs": "pnpm --filter @leaf-ui/docs build",
    "build:versions": "node apps/docs/scripts/build-versioned-site.mjs",
    "preview": "pnpm --filter @leaf-ui/docs preview",
    "typecheck": "pnpm -r typecheck",
    "lint": "biome check . && prettier --check \"**/*.scss\"",
    "format": "biome check --write . && prettier --write \"**/*.scss\"",
    "test": "pnpm --filter @sudden3/leaf-ui test && pnpm test:release && pnpm test:docs && pnpm test:skills",
    "test:release": "node --test packages/react/scripts/check-release-notes.test.mjs",
    "test:docs": "node --test apps/docs/scripts/versioned-docs.test.mjs",
    "test:skills": "node --test skills/tests/docs.test.mjs",
    "test:watch": "pnpm --filter @sudden3/leaf-ui test:watch",
    "check": "pnpm check:release && pnpm lint && pnpm typecheck && pnpm test",
    "check:release": "node packages/react/scripts/check-release-notes.mjs",
    "format:scss": "prettier --write \"**/*.scss\""
  },
  "devDependencies": {
    "@babel/parser": "^7.29.9",
    "@biomejs/biome": "^2.5.15",
    "@types/node": "^26.6.4",
    "opencc-js": "^1.4.2",
    "prettier": "^3.9.9",
    "typescript": "^7.0.2"
  }
}
