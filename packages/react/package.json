{
  "name": "@sudden3/leaf-ui",
  "version": "0.3.0",
  "description": "A lightweight React component library with CSS variable theming.",
  "homepage": "https://ifhover.github.io/leaf-ui/",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/ifhover/leaf-ui.git",
    "directory": "packages/react"
  },
  "bugs": {
    "url": "https://github.com/ifhover/leaf-ui/issues"
  },
  "keywords": [
    "react",
    "ui",
    "components",
    "leaf-ui",
    "scss",
    "css-variables"
  ],
  "type": "module",
  "main": "./dist/cjs/index.cjs",
  "module": "./dist/esm/index.js",
  "types": "./dist/esm/index.d.ts",
  "exports": {
    ".": {
      "import": {
        "types": "./dist/esm/index.d.ts",
        "default": "./dist/esm/index.js"
      },
      "require": {
        "types": "./dist/cjs/index.d.cts",
        "default": "./dist/cjs/index.cjs"
      }
    },
    "./styles.css": "./dist/esm/styles/index.css",
    "./package.json": "./package.json"
  },
  "files": [
    "dist",
    "README.md",
    "THIRD_PARTY.md"
  ],
  "sideEffects": [
    "**/*.css"
  ],
  "scripts": {
    "build": "rslib build",
    "dev": "rslib build --watch",
    "typecheck": "tsc --noEmit -p tsconfig.json && tsc --noEmit -p tsconfig.test.json",
    "test": "vitest run",
    "test:watch": "vitest",
    "prepublishOnly": "pnpm check:release && pnpm build && pnpm check:package",
    "check:release": "node ./scripts/check-release-notes.mjs",
    "check:package": "node ./scripts/verify-package.mjs"
  },
  "peerDependencies": {
    "react": "^18.0.0 || ^19.0.0",
    "react-dom": "^18.0.0 || ^19.0.0"
  },
  "devDependencies": {
    "@rsbuild/plugin-react": "^2.1.1",
    "@rsbuild/plugin-sass": "^2.0.1",
    "@rslib/core": "^1.0.3",
    "@testing-library/dom": "^10.4.2",
    "@testing-library/jest-dom": "^7.0.1",
    "@testing-library/react": "^16.3.3",
    "@testing-library/user-event": "^14.6.7",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "jsdom": "^30.1.1",
    "react": "^19.3.0",
    "react-dom": "^19.3.0",
    "vite": "^8.3.2",
    "vitest": "^5.0.3"
  },
  "publishConfig": {
    "access": "public",
    "registry": "https://registry.npmjs.org/"
  },
  "dependencies": {
    "@ctrl/tinycolor": "^4.2.1",
    "@dnd-kit/core": "^6.3.1",
    "@dnd-kit/sortable": "^10.0.0",
    "@dnd-kit/utilities": "^3.2.2",
    "@floating-ui/react-dom": "^2.1.9",
    "@tanstack/react-virtual": "^3.14.13",
    "lucide-react": "^1.50.0",
    "qrcode.react": "^4.2.0",
    "react-image-crop": "^11.1.2",
    "react-imask": "^7.6.1",
    "signature_pad": "^5.1.4",
    "tabbable": "^6.5.0",
    "yet-another-react-lightbox": "^3.32.2"
  }
}
